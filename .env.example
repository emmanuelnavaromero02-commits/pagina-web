# ---------------------------------------------------------------
# Variables públicas (se inyectan en build time, se ven en el cliente)
# Copia este archivo a .env.local y rellena con valores reales.
# ---------------------------------------------------------------

# URL canónica del sitio en producción. Se usa para:
#   - metadataBase (OG, Twitter, canonical)
#   - sitemap.xml
#   - robots.txt
# Ejemplo: https://www.tudominio.com
NEXT_PUBLIC_SITE_URL=https://example.com

# Endpoint público al que el formulario de contacto enviará el payload.
# Está pensado para apuntar a API Gateway que invoca Lambda + SES en AWS.
# Si esta variable queda vacía en build time, el formulario muestra el
# payload en la UI sin hacer ninguna petición real (modo placeholder).
# Ejemplo: https://api.tudominio.com/contact
NEXT_PUBLIC_CONTACT_ENDPOINT=
