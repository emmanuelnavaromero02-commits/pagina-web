# Configuración pública de build. No incluir secretos ni credenciales AWS.

NEXT_PUBLIC_SITE_URL=https://www.7businesssolutions.com
NEXT_PUBLIC_CONTACT_ENDPOINT=https://api.7businesssolutions.com/v1/contact

# Mantener en false para preview. En true, el build exige endpoint y revisión
# legal final; además permite indexación.
NEXT_PUBLIC_LAUNCH_READY=false
NEXT_PUBLIC_LEGAL_REVIEWED=false

# Lanzamiento temporal dirigido únicamente a México. Cambiar a true solo al
# activar comercialmente la Unión Europea; entonces el build exige representante.
NEXT_PUBLIC_EU_MARKET_ENABLED=false

# Obligatorio únicamente cuando NEXT_PUBLIC_EU_MARKET_ENABLED=true.
NEXT_PUBLIC_EU_REP_NAME=
NEXT_PUBLIC_EU_REP_ADDRESS=
NEXT_PUBLIC_EU_REP_EMAIL=
